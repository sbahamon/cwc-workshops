",\"request_id\":\"req_33e5026f5a4d\",\"upstream\":\"idp.internal\"}\n{\"ts\":\"2026-04-22T14:15:14.000Z\",\"level\":\"ERROR\",\"service\":\"auth\",\"host\":\"auth-2\",\"msg\":\"upstream identity-provider timeout after 5000ms\",\"request_id\":\"req_026f2cfc4b5d\",\"upstream\":\"idp.internal\"}\n{\"ts\":\"2026-04-22T14:15:22.000Z\",\"level\":\"WARN\",\"service\":\"auth\",\"host\":\"auth-2\",\"msg\":\"GC pause 122ms (G1 young gen)\"}\n   3913 * FROM\n    520  \n     70 pool exhausted\n      6 timeout after\n      2 for idp.internal\n      2 325ms (G1\n      1 utilization active=50/50\",\"request_id\":\"req_c8bfd7f0cf1e\"}\n      1 utilization active=50/50\",\"request_id\":\"req_6dcb5b5fc8ed\"}\n      1 utilization active=50/50\",\"request_id\":\"req_3b7d11d9c2ee\"}\n      1 utilization active=49/50\",\"request_id\":\"req_f37efcf49f0b\"}\n", "type": "text"}], "is_error": false}
